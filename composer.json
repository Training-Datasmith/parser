{
	"name": "fuel/parser",
	"description" : "FuelPHP 1.x Parser Package",
	"type": "fuel-package",
	"homepage": "https://github.com/fuel/parser",
	"license": "MIT",
	"authors": [
		{
			"name": "FuelPHP Development Team",
			"email": "team@fuelphp.com"
		}
	],
	"require": {
		"composer/installers": "^2.3.0"
	},
	"require-dev": {
		"fuel/core": "1.9.0-dev",
		"monolog/monolog": "^1.18|^2|^3",
		"psr/log": "^1.1|^2|^3",
		"michelf/php-markdown": "~1.9.1",
		"phpseclib/phpseclib": "~3.0",
		"paragonie/sodium_compat": "^1|^2",
		"twig/twig": "3.11.3",
		"mustache/mustache": "3.2.0",
		"smarty/smarty": "4.5.8",
		"league/plates": "3.5.0",
		"pyrocms/lex": "2.3.2",
		"zordius/lightncandy": "1.2.6",
		"talesoft/tale-jade": "1.4.5",
		"dwoo/dwoo": "1.3.7",
		"phptal/phptal": "1.4.0"
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "fuel/core",
				"version": "1.9.0-dev",
				"type": "fuel-package",
				"dist": {
					"type": "zip",
					"url": "https://api.github.com/repos/fuel/core/zipball/c82b10b8000363bdc6951f023e455c4862ad3fee",
					"reference": "c82b10b8000363bdc6951f023e455c4862ad3fee"
				}
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ParserTests\\": "tests/"
		}
	}
}
